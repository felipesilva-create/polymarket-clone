generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Models
model User {
  id             String     @id @default(cuid())
  name           String?
  email          String?    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  balance        Float      @default(1000)
  initialBalance Float      @default(1000)
  totalPnL       Float      @default(0)
  totalWins      Int        @default(0)
  totalLosses    Int        @default(0)
  winRate        Float      @default(0)
  rank           Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  accounts       Account[]
  sessions       Session[]
  positions      Position[]
  trades         Trade[]
}

model Position {
  id             String   @id @default(cuid())
  userId         String
  marketId       String
  marketQuestion String
  outcome        String
  shares         Float
  avgPrice       Float
  currentPrice   Float
  totalInvested  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId, outcome])
}

model Trade {
  id             String   @id @default(cuid())
  userId         String
  marketId       String
  marketQuestion String
  outcome        String
  type           String
  shares         Float
  price          Float
  total          Float
  pnl            Float?
  resolved       Boolean  @default(false)
  won            Boolean?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
